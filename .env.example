# Copy to .env and fill in. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Local Postgres (docker compose)
POSTGRES_USER=fitgate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitgate
# Host port; 5433 avoids clashing with a native Postgres on 5432
POSTGRES_PORT=5433

# Prisma
# Local: both point at the docker compose database.
# Neon: DATABASE_URL = pooled connection string, DIRECT_URL = direct (unpooled) connection string.
DATABASE_URL=postgresql://fitgate:change-me@localhost:5433/fitgate
DIRECT_URL=postgresql://fitgate:change-me@localhost:5433/fitgate

# Tests (Vitest). Separate database on the same server; the name must end in _test.
TEST_DATABASE_URL=postgresql://fitgate:change-me@localhost:5433/fitgate_test

# Better Auth
# Secret: 32+ random bytes. URL: public origin of the app (no trailing slash).
BETTER_AUTH_SECRET=replace-with-random-secret
BETTER_AUTH_URL=http://localhost:3000

# HMAC secret for stored hashes (trial email/phone, rate-limit keys, IP hashes).
# Each purpose uses its own prefix. 32+ random bytes.
HASH_SECRET=replace-with-random-secret

# Redis (rate limiting)
# Local: the srh service in docker compose (REST proxy in front of the redis service);
# the token must equal SRH_TOKEN. Production: Upstash REST URL and token.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=replace-with-random-token
SRH_TOKEN=replace-with-random-token

# Email
# EMAIL_TRANSPORT: smtp (Mailpit locally, UI at http://localhost:8025) or console.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="FitGate <no-reply@fitgate.local>"
